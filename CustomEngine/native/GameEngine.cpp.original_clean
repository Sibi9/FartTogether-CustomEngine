// Gas Energy State (Per Pirate)

struct PirateGasState {

    float gasEnergy;

    bool  gasDepleted;

    float regenDelayTimer;

    float pressTimer;

    bool  isPressing;

    bool  isSustained;

    float sustainedCharge; // 0.0 to 1.0

    float releaseTimer;

    float releaseStartCharge;

    // Visual Butt State

    float boneScale;

    float trembleOffset;

    float redness;

    float jigglePhase;

    void Reset() {

        gasEnergy = GAS_MAX;

        gasDepleted = false;

        regenDelayTimer = 0.0f;

        pressTimer = 0.0f;

        isPressing = false;

        isSustained = false;

        sustainedCharge = 0.0f;

        releaseTimer = 0.0f;

        releaseStartCharge = 0.0f;

        boneScale = 1.0f;

        trembleOffset = 0.0f;

        redness = 0.0f;

        jigglePhase = 0.0f;

    }

    void Update(float dt, bool inputDown, float runTime) {

        jigglePhase += dt * 10.0f;

        if (inputDown && !gasDepleted) {

            isPressing = true;

            pressTimer += dt;

            regenDelayTimer = GAS_REGEN_DELAY;

            if (pressTimer > GAS_TAP_THRESHOLD_SECONDS) {

                // Sustained Hold

                isSustained = true;

                sustainedCharge = Clamp((pressTimer - GAS_TAP_THRESHOLD_SECONDS) / GAS_RAMP_SECONDS, 0.0f, 1.0f);

                gasEnergy -= GAS_DRAIN_PER_SEC * dt;

                if (gasEnergy <= 0.0f) {

                    gasEnergy = 0.0f;

                    gasDepleted = true;

                    isSustained = false;

                    isPressing = false;

                    pressTimer = 0.0f;

                }

            }

        } else {

            // Released or depleted

            if (isPressing) {

                // If released after sustained hold, start release decay

                if (isSustained) {

                    releaseTimer = GAS_RELEASE_SECONDS;

                    releaseStartCharge = sustainedCharge;

                }

                isPressing = false;

                isSustained = false;

                pressTimer = 0.0f;

            }

            if (releaseTimer > 0.0f) {

                releaseTimer -= dt;

                if (releaseTimer < 0.0f) releaseTimer = 0.0f;

            }

            // Gas Regeneration

            if (regenDelayTimer > 0.0f) {

                regenDelayTimer -= dt;

            } else {

                gasEnergy += GAS_REGEN_PER_SEC * dt;

                if (gasEnergy >= GAS_MAX) {

                    gasEnergy = GAS_MAX;

                    gasDepleted = false;

                } else if (gasDepleted && (gasEnergy / GAS_MAX) >= GAS_RECOVER_PERCENT) {

                    gasDepleted = false;

                }

            }

            sustainedCharge = 0.0f;

        }

        // Compute effective visual charge

        float visualCharge = sustainedCharge;

        if (releaseTimer > 0.0f) {

            visualCharge = releaseStartCharge * (releaseTimer / GAS_RELEASE_SECONDS);

        }

        // Butt Bone Swell (1.0x to 1.4x)

        boneScale = 1.0f + (BUTT_PEAK_SCALE - 1.0f) * visualCharge;

        // Tremble vibration at 12Hz above 55% charge

        if (visualCharge > BUTT_MIN_TREMBLE_THRESHOLD) {

            float strength = (visualCharge - BUTT_MIN_TREMBLE_THRESHOLD) / (1.0f - BUTT_MIN_TREMBLE_THRESHOLD);

            trembleOffset = sinf(2.0f * PI * BUTT_TREMBLE_FREQ * runTime) * BUTT_TREMBLE_AMP * strength;

        } else {

            trembleOffset = 0.0f;

        }

        // Vascular Redness Curve (starts at 60% charge)

        if (visualCharge > 0.60f) {

            float rFrac = (visualCharge - 0.60f) / 0.40f;

            redness = powf(rFrac, 2.5f);

        } else {

            redness = 0.0f;

        }

    }

};

